# OpenDots template: the UI opens in setup state until these fields are configured.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# MongoDB Atlas Configuration (Enables cloud database for mobile & desktop sync)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=opendots
# Keep OWNER_ID stable: it owns the persistent Intelligence conversations.
OWNER_ID=opendots-owner
# npm run dev allows http://localhost:5173 and http://127.0.0.1:5173.
# APP_ORIGIN replaces these defaults with comma-separated exact origins.
# Include scheme, hostname and port; omit paths and trailing slashes.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required for an external HOST binding (24+ characters); enables local login too.
# OWNER_TOKEN=

# `copilotkit project select` or `local connect` writes CPK_INTELLIGENCE_API_KEY.
# The server accepts either name and prefers a non-empty CPK_INTELLIGENCE_API_KEY.
INTELLIGENCE_API_KEY=
CPK_INTELLIGENCE_API_KEY=
CPK_TELEMETRY_ID=
# INTELLIGENCE_API_URL=
# `local connect` writes this endpoint; it takes precedence over the legacy name.
# INTELLIGENCE_GATEWAY_WS_URL=
# INTELLIGENCE_WS_URL=

# Multi-Provider Local Smart Router Configuration (http://127.0.0.1:4315/v1)
SMART_ROUTER_PORT=4315
SMART_ROUTER_HOST=127.0.0.1
# Optional local auth token between OpenDots and SmartRouter
SMART_ROUTER_CLIENT_KEY=
# Secret token for /__admin/* runtime model switching mutations
SMART_ROUTER_ADMIN_TOKEN=opendots-smart-router-admin

# Upstream Provider Credentials
RADOX_API_KEY=
RADOX_BASE_URL=https://radoxai.com/v1
RADOX_BEST_MODEL=claude-opus-5.5
RADOX_FAST_MODEL=gpt-5.6-luna

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BEST_MODEL=z-ai/glm-5.3
NVIDIA_FAST_MODEL=z-ai/glm-5.3-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1

CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BASE_URL=

# OpenDots Agent Target (Routes through local SmartRouter by default)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:4315/v1
OPENAI_MODEL=meta/llama-3.2-11b-vision-instruct,nvidia/nemotron-3-super-120b-a12b

# Optional EmbeddingGemma 2 service for semantic search over saved preferences.
# Server-side only: keep the API key out of source control and browser code.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSIONS=768

# Keep the CLI-generated CPK_TELEMETRY_ID with its matching project key.
# The SDK uses it to connect OpenDots usage to the Intelligence account.
# CPK_TELEMETRY_ID=
# SDK usage telemetry is enabled by default (separate from conversations).
# See docs/TELEMETRY.md for signup reporting and validation.
# Optional sampling override (default 1):
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Either flag below opts out:
COPILOTKIT_TELEMETRY_DISABLED=
# DO_NOT_TRACK=1

# Optional isolated read-only public-page browser for WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use the same random 24+ character secret in app/browser. All redirects are blocked.
# Supply canonical public URLs. Use the separate browser container for isolation.

# Optional realtime speech; compute uses the same configured Intelligence thread.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Optional managed Slack channel; see docs/SETUP.md#slack.
# Match the managed declaration name, not a Slack #conversation name.
# OpenTag calls this INTELLIGENCE_CHANNEL_NAME; OpenDots uses SLACK_CHANNEL_NAME.
# Allowlist both the Slack workspace and explicit Slack user IDs.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Optional persistent computers, one per Dot, using OpenBot services.
# See docs/COMPUTERS.md. Keep these two different random secrets on the server.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Keep stable: the namespace identifies existing containers and persistent volumes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Public-web provider. parallel (default), browser (URL-only), or disabled.
# Queries and selected URLs are sent to Parallel; sample mode makes no provider calls.
WEB_SEARCH_PROVIDER=parallel
# Optional Bearer key for production/higher limits; anonymous MCP supports light use.
PARALLEL_API_KEY=

# Development / Frontend Flags
VITE_CONFIG_NATIVE_IGNORE_WARNING=

# ==============================================================================
# Backblaze B2 Durable Object Storage & Backup Encryption
# ==============================================================================
# S3-compatible Backblaze B2 endpoint URL (e.g. https://s3.us-east-005.backblazeb2.com).
# B2_ENDPOINT is also supported for backward compatibility.
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# The Backblaze region where your storage bucket was created (e.g. us-east-005).
B2_REGION=us-east-005

# Name of the Backblaze B2 bucket configured for durable backups.
# B2_BUCKET_NAME is also supported for backward compatibility.
B2_BUCKET=opendots-persistence-20261021

# Dedicated, bucket-restricted Backblaze B2 Application Key ID (do not use account master key).
B2_KEY_ID=

# Dedicated Backblaze B2 Application Key secret.
B2_APPLICATION_KEY=

# Application-side authenticated encryption key for sensitive backups (browser profiles, sessions, workspaces).
# Format: 64-character hex string (32 bytes) or 32+ character passphrase.
# WARNING: Must be durable and persisted. Losing this key prevents backup recovery.
# Do not reuse B2_APPLICATION_KEY as this key.
OPENDOTS_BACKUP_ENCRYPTION_KEY=
