{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "opendots-computers",
  "main": "worker.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "containers": [
    {
      "name": "opendots-dot-computer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DOT_COMPUTERS", "class_name": "DotComputer" }
    ]
  },
  "exports": {
    "DotComputer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "opendots-dot-computer"
    }
  }
}
